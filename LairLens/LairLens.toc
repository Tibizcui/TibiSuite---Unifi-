# -----------------------------------------------------------------------------
# Interface 120100 = patch 12.1.0 live. Le workflow interface-version.yml
# auto-bumpe la valeur, donc pas de "AddOn out of date" au prochain build.
# -----------------------------------------------------------------------------

# 0. Copie embarquee du socle (no-op si le core en charge deja une version
#    egale ou superieure)
Core\TibiSuiteUI.lua

# 1. Noyau : namespace, constantes, evenements, etat persistant.
Core\Init.lua
Core\Constants.lua
Core\Util.lua
# 2. Localisation (enUS d'abord comme base, puis surcharges de langue).
Locales\enUS.lua
Locales\frFR.lua
Locales\deDE.lua
Locales\esES.lua
Locales\itIT.lua
Locales\ptBR.lua
Locales\ruRU.lua
Locales\koKR.lua
Locales\zhCN.lua
Locales\zhTW.lua

# 3. Donnees : taxonomie du contenu et heuristiques de capacites.
Data\Data.lua
Data\Capabilities.lua

# 4. Couche d'abstraction : tout ce qui touche l'API des Repaires.
Core\Abstraction\Detection.lua
Core\Abstraction\Journal.lua
Core\Abstraction\Roster.lua
Core\Abstraction\Lockouts.lua
Core\Probe.lua

# 5. Module 1 : audit de groupe.
Modules\GroupAudit\AuditLogic.lua
Modules\GroupAudit\AuditFrame.lua

# 6. Module 2 : pertinence des recompenses (ilvl du butin, Ecus de brume).
Modules\RewardRelevance\RewardData.lua
Modules\RewardRelevance\RewardLogic.lua

# 6b. Module d'historique / dashboard des runs (donnee -> capture -> UI).
Modules\RunHistory\RunData.lua
Modules\RunHistory\RunTracker.lua
Modules\RunHistory\DashboardFrame.lua

# 6c. Fiche du Repaire (semaine, butin de la spe, hauts faits, records).
Modules\LairInfo\InfoFrame.lua

# 6d. API publique (WeeklyCompass, DgnTracker, Stats) + resume pour l'export.
API.lua

# 7. Integration TibiSuite : inscription comme onglet + recherche globale.
#    Ce glue remplace l'ancien Modules\Suite\LairLens_Suite.lua.
LairLens_Module.lua
