# egale ou superieure)
Core\TibiSuiteUI.lua

# Compresseur LZW maison (pas de dependance externe) - utilise par Export.lua
Libs\LZW.lua

# Localisation (enUS = base, frFR = surcharge si le client est en francais)
Locales\enUS.lua
Locales\frFR.lua
Locales\deDE.lua
Locales\esES.lua

Constants.lua
Core.lua
Backfill.lua
UI.lua
Export.lua

## Glue TibiSuite : inscription comme onglet du catalogue unifie
Stats_Module.lua
